node_modules
dist
data/*.sqlite
data/*.sqlite-*
.env
*.log

# Локальные настройки среды агента (права на команды и т.п.) — у каждой машины свои.
# Именно этот файл, а не вся .claude/: общие настройки проекта коммитить можно.
.claude/settings.local.json

# Отчёты по безопасности (/cso): содержат проверенные сценарии эксплуатации и
# email админа — в репозитории им не место, коммит понизил бы стоимость атаки.
# Хранятся только локально.
.gstack/

# /graphify — генерируемый граф знаний по кодовой базе. Кэш семантического разбора
# может нести имя владельца, внутреннюю архитектуру и абсолютные локальные пути
# (найдено адверсариальным ревью) — репозиторию не нужен, каждая машина строит свой.
graphify-out/
