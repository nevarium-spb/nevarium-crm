# Скопируйте в deploy/.env и заполните. НИКОГДА не коммитьте .env.

# Строка подключения к управляемому Postgres (перевод на Postgres, план в
# nevarium-lab#3) — заменяет прежний DB_FILE (путь к SQLite). Формат:
# postgresql://user:password@host:5432/dbname?sslmode=require
# Выдаёт панель Timeweb Cloud при заказе Managed PostgreSQL (Этап 2 плана переезда).
DATABASE_URL=

# Секрет подписи сессий — сгенерируйте: openssl rand -hex 32
JWT_SECRET=

# Телеграм-бот (создать у @BotFather), бот должен быть добавлен в группу.
# TG_CHAT_ID группы: перешлите сообщение боту @getmyid_bot или см. deploy/README.md
TG_BOT_TOKEN=
TG_CHAT_ID=

# Бот в MAX (создать в MAX для бизнеса, dev.max.ru) — уведомления уходят параллельно
# с Telegram, независимо: если не заполнить, канал просто не используется.
# ВАЖНО: ночной бэкап базы уходит ТОЛЬКО в MAX (в базе ПДн, Telegram зарубежный —
# см. ADR-009). Без MAX офф-бокс копии не будет, только копия на диске сервера.
MAX_BOT_TOKEN=
MAX_CHAT_ID=

# Адрес CRM — из него собирается ссылка на карточку заявки в Telegram-уведомлении.
# Без него уведомление придёт без ссылки (заявка всё равно сохранится).
CRM_BASE_URL=https://crm.example.ru

# Тот же адрес (с https://, БЕЗ слеша на конце) — для строгой CSRF-проверки на
# мутациях /api/crm/*. Без него проверка сравнивает Origin с X-Forwarded-Host, а
# это заголовок, который в общем случае подставляет клиент, а не прокси. Задать
# на проде ОБЯЗАТЕЛЬНО — независимый аудит безопасности отметил это как риск.
# APP_ORIGIN=https://crm-nevarium.ru

# Ключ настольного приложения NVizor (Невариум Визор) для /api/nvizor/* — общая
# история бесплатных отчётов тарифа Free для всех ПК эксперта (server/nvizor.js,
# ADR-016). Не короче 32 символов; тот же ключ вводится в «Настройках» приложения на
# каждом ПК. Не задан — эти эндпоинты отвечают 503, остальная CRM работает как раньше.
# NVIZOR_APP_TOKEN=

# Почта для служебных писем СОТРУДНИКАМ (восстановление пароля, смена email; ADR-020).
# Только служебные письма — никаких писем клиентам и данных клиентов (152-ФЗ).
# Не заданы — «Забыли пароль?» честно пишет «недоступно», работают запасные пути
# `npm run reset-admin` и `npm run change-email`. Ссылки в письмах — от CRM_BASE_URL.
#
# СПОСОБ 1 (нужен на Timeweb App Platform: хостинг режет исходящий SMTP — таймаут на 465/587/2525):
# Yandex Cloud Postbox по HTTPS (первые 2000 писем в месяц бесплатно). POSTBOX_KEY_ID и POSTBOX_SECRET_KEY —
# статический ключ сервисного аккаунта с ролью postbox.sender; SMTP_FROM — адрес отправителя на домене
# с подтверждённым DKIM. Если заданы ключи Postbox, SMTP ниже не используется.
# POSTBOX_KEY_ID=
# POSTBOX_SECRET_KEY=
# MAIL_FROM_NAME=Невариум CRM
#
# СПОСОБ 2: SMTP (Gmail: SMTP_PASS — «пароль приложения» Google).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Фото объекта из формы заявки сайта Визора (ADR-022): приватный бакет S3 Timeweb. Диск контейнера
# стирается при деплое, поэтому фото живут только там. Не заданы — приём фото отвечает 503, заявки
# принимаются как раньше. Проверка: `npm run test-s3`. Ключи — только в настройках приложения Timeweb.
# S3_ENDPOINT=https://s3.twcstorage.ru
# S3_BUCKET=nevarium-crm-photo
# S3_REGION=ru-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Правило CORS бакета для видео с телефона (npm run test-s3 cors apply); по умолчанию — домены сайта Визора.
# S3_CORS_ORIGINS=https://nevarium-vizor.ru,https://www.nevarium-vizor.ru

# Письма клиенту (ADR-025; включаются в «Настройках» CRM, по умолчанию выключены). Необязательно:
# CLIENT_MAIL_FROM_NAME=Невариум Визор
# CLIENT_MAIL_REPLY_TO=nvizor-spb@yandex.ru
# CLIENT_GUIDE_URL=          # ссылка на памятку «как снимать» в письме о фото этапа
# Лимит тарифа хранилища в МБ — для счётчика «занято из …» в «Настройках» (умолчание 1024 = 1 ГБ).
# PHOTO_STORAGE_LIMIT_MB=1024

# База личной ссылки клиента в кабинет на сайте Визора (тарифы клиентов, ADR-019):
# ссылка выдаётся как «<база>/#/c/<ключ>». Не задана — https://nevarium-vizor.ru.
# CLIENT_CABINET_URL=https://nevarium-vizor.ru

# Сколько прокси-хопов перед приложением доверять для определения IP клиента.
# По умолчанию 1 (App Platform ставит один прокси перед контейнером). Менять, только
# если после деплоя окажется, что req.ip в логах — это IP прокси, а не клиента:
# тогда увеличить на число реальных хопов. НЕ ставить в true — с true клиент может
# подделать свой IP заголовком X-Forwarded-For (см. server/app.js).
# TRUST_PROXY_HOPS=1

PORT=3001
