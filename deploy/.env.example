# Скопируйте в deploy/.env и заполните. НИКОГДА не коммитьте .env.

# Секрет подписи сессий — сгенерируйте: openssl rand -hex 32
JWT_SECRET=

# Телеграм-бот (создать у @BotFather), бот должен быть добавлен в группу.
# TG_CHAT_ID группы: перешлите сообщение боту @getmyid_bot или см. deploy/README.md
TG_BOT_TOKEN=
TG_CHAT_ID=

# Бот в MAX (создать в MAX для бизнеса, dev.max.ru) — уведомления уходят параллельно
# с Telegram, независимо: если не заполнить, канал просто не используется.
# ВАЖНО: ночной бэкап базы уходит ТОЛЬКО в MAX (в базе ПДн, Telegram зарубежный —
# см. ADR-009). Без MAX офф-бокс копии не будет, только копия на диске сервера.
MAX_BOT_TOKEN=
MAX_CHAT_ID=

# Адрес CRM — из него собирается ссылка на карточку заявки в Telegram-уведомлении.
# Без него уведомление придёт без ссылки (заявка всё равно сохранится).
CRM_BASE_URL=https://crm.example.ru

# Тот же адрес (с https://, БЕЗ слеша на конце) — для строгой CSRF-проверки на
# мутациях /api/crm/*. Без него проверка сравнивает Origin с X-Forwarded-Host, а
# это заголовок, который в общем случае подставляет клиент, а не прокси. Задать
# на проде ОБЯЗАТЕЛЬНО — независимый аудит безопасности отметил это как риск.
# APP_ORIGIN=https://crm-nevarium.ru

# Сколько прокси-хопов перед приложением доверять для определения IP клиента.
# По умолчанию 1 (App Platform ставит один прокси перед контейнером). Менять, только
# если после деплоя окажется, что req.ip в логах — это IP прокси, а не клиента:
# тогда увеличить на число реальных хопов. НЕ ставить в true — с true клиент может
# подделать свой IP заголовком X-Forwarded-For (см. server/app.js).
# TRUST_PROXY_HOPS=1

PORT=3001
