# Что НЕ попадает в контекст сборки образа (deploy/Dockerfile делает `COPY . .`).
#
# Главное здесь — node_modules. Dockerfile сначала ставит зависимости под Alpine
# (`npm ci` + `npm rebuild better-sqlite3`), и если следом `COPY . .` притащит
# локальную папку, собранную под Windows или macOS, нативные бинарники
# better-sqlite3 перезапишутся чужими и контейнер упадёт при старте.
# На App Platform это не всплывает (сборка идёт из git, где node_modules нет),
# а вот при локальной сборке по Варианту Б — всплывает сразу.
node_modules
dist

# База и её WAL-файлы: копия чужих данных в образе не нужна никому.
data/*.sqlite
data/*.sqlite-*
data/backups

# Секреты. В git их и так нет, но при локальной сборке .env лежит на диске
# рядом — в контекст сборки он попадать не должен.
.env
deploy/.env

.git
.github
.claude
*.log
